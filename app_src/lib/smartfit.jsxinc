/* globals app, charID, charIDToTypeID, jamText, jamEngine, executeAction, executeActionGet, ActionDescriptor, ActionReference, DialogModes, stringIDToTypeID, LayerKind, UnitValue, _ensureStyle, _checkSelection, _DEFAULT_ADJUST_SEQUENCE, _calculateSelectionDimensions, _createAndSetLayerText, _getCurrentTextLayerBounds, _resizeTextBoxToContent, _positionLayerWithinSelection, _changeToPointText, _setTextBoxSize */

var SmartFitEngine = (function () {
  function forceLayoutUpdate() {
    try {
      app.refresh();
    } catch (e) {}
  }

  function getRenderedTextBounds() {
    return _getCurrentTextLayerBounds();
  }

  function setLayerFontSize(size) {
    size = Math.round(size);
    try {
      if (app.documents.length && app.activeDocument && app.activeDocument.activeLayer) {
        var layer = app.activeDocument.activeLayer;
        if (layer.kind === LayerKind.TEXT && layer.textItem) {
          layer.textItem.size = new UnitValue(size, "pt");
        }
      }
    } catch (e1) {}

    try {
      var idset = charIDToTypeID("set ");
      var idnull = charIDToTypeID("null");
      var idTxLr = charIDToTypeID("TxLr");
      var idOrdn = charIDToTypeID("Ordn");
      var idTrgt = charIDToTypeID("Trgt");
      var idT = charIDToTypeID("T   ");
      var idTxtS = charIDToTypeID("TxtS");
      var idSz = charIDToTypeID("Sz  ");
      var idPnt = charIDToTypeID("#Pnt");

      var desc1 = new ActionDescriptor();
      var ref1 = new ActionReference();
      ref1.putProperty(idTxtS, idTxLr);
      ref1.putEnumerated(idTxLr, idOrdn, idTrgt);
      desc1.putReference(idnull, ref1);

      var desc2 = new ActionDescriptor();
      desc2.putUnitDouble(idSz, idPnt, size);
      desc1.putObject(idT, idTxtS, desc2);
      executeAction(idset, desc1, DialogModes.NO);
    } catch (err) {}
  }

  function setLayerTracking(trackingValue) {
    try {
      var textParams = jamText.getLayerText();
      if (textParams && textParams.layerText && textParams.layerText.textStyleRange) {
        for (var i = 0; i < textParams.layerText.textStyleRange.length; i++) {
          if (textParams.layerText.textStyleRange[i].textStyle) {
            textParams.layerText.textStyleRange[i].textStyle.tracking = trackingValue;
          }
        }
        jamText.setLayerText(textParams);
      }
    } catch (e) {}
  }

  function checkOverflow(renderedBounds, containerWidth, containerHeight) {
    if (!renderedBounds) return false;
    var heightOverflow = renderedBounds.height > (containerHeight + 0.5);
    var widthOverflow = renderedBounds.width > (containerWidth + 0.5);
    return heightOverflow || widthOverflow;
  }

  // Smart Fit v3: Safe Area Calculation based on Bubble Geometry and Padding
  function calculateSafeArea(width, height, customRatio, padding) {
    var ratio;
    if (typeof customRatio === "number" && customRatio > 0 && customRatio <= 1) {
      ratio = customRatio;
    } else {
      var R = width / (height || 1);
      if (R < 0.6) {
        ratio = 0.65;
      } else if (R < 0.9) {
        ratio = 0.70;
      } else if (R <= 1.2) {
        ratio = 0.75;
      } else {
        ratio = 0.80;
      }
    }

    var targetWidth = width * ratio;
    var targetHeight = Math.min(height * Math.sqrt(1 - ratio * ratio) * 0.95, height * ratio);

    if (padding > 0) {
      targetWidth = Math.max(targetWidth - padding * 2, 50);
      targetHeight = Math.max(targetHeight - padding * 2, 30);
    }

    if (targetWidth <= 0) targetWidth = width;
    if (targetHeight <= 0) targetHeight = height;

    return {
      width: targetWidth,
      height: targetHeight,
      ratio: ratio
    };
  }

  function fitTextInSelection(data, options) {
    options = options || {};
    var safeAreaRatio = options.safeAreaRatio;
    var minFontSize = Math.floor((typeof options.minFontSize === "number") ? options.minFontSize : 6);

    // Step 1: Ensure Style & Get Original Font Size (Integer)
    var style = _ensureStyle(data.style);
    var styleFontSize = 20;
    if (style && style.textProps && style.textProps.layerText &&
        style.textProps.layerText.textStyleRange &&
        style.textProps.layerText.textStyleRange[0] &&
        style.textProps.layerText.textStyleRange[0].textStyle &&
        style.textProps.layerText.textStyleRange[0].textStyle.size) {
      styleFontSize = style.textProps.layerText.textStyleRange[0].textStyle.size;
    }
    styleFontSize = Math.floor(styleFontSize);

    // Step 2: Selection Bounds & Safe Text Area
    var selection = _checkSelection({
      adjustSequence: _DEFAULT_ADJUST_SEQUENCE,
      preExpandAmount: styleFontSize
    });
    if (selection.error) {
      return selection.error;
    }

    var rawDimensions = _calculateSelectionDimensions(selection, 0);
    var safeArea = calculateSafeArea(rawDimensions.width, rawDimensions.height, safeAreaRatio, options.padding || 0);
    var containerWidth = safeArea.width;
    var containerHeight = safeArea.height;

    // Step 3: Insert Text with Original Font Size into Temporary Container (height = 99999)
    _createAndSetLayerText(data, containerWidth, 99999);
    forceLayoutUpdate();

    var initialBounds = getRenderedTextBounds();
    var isOverflow = checkOverflow(initialBounds, containerWidth, containerHeight);
    var bestFittingSize = styleFontSize;

    // Step 4: Integer-Only Binary Search for Maximum Fitting Font Size
    if (isOverflow) {
      var low = minFontSize;
      var high = styleFontSize;
      bestFittingSize = minFontSize;

      while (low <= high) {
        var mid = Math.floor((low + high) / 2);
        if (mid < minFontSize) break;

        setLayerFontSize(mid);
        forceLayoutUpdate();
        var currentBounds = getRenderedTextBounds();
        var currentOverflow = checkOverflow(currentBounds, containerWidth, containerHeight);

        if (!currentOverflow) {
          bestFittingSize = mid;
          low = mid + 1; // Fits! Try larger integer font size
        } else {
          high = mid - 1; // Overflows! Try smaller integer font size
        }
      }
    }

    // Step 5: Set Optimal Integer Font Size
    setLayerFontSize(bestFittingSize);
    forceLayoutUpdate();

    // Step 6: Fit Box Height & Center Layer
    if (options.point) {
      _changeToPointText();
    } else {
      var endBounds = getRenderedTextBounds();
      _resizeTextBoxToContent(containerWidth, endBounds);
    }
    var finalLayerBounds = getRenderedTextBounds();
    _positionLayerWithinSelection(selection, finalLayerBounds);

    // Step 7: Auto Tracking Fallback (-25, then -50) if still overflows at min size
    if (checkOverflow(finalLayerBounds, containerWidth, containerHeight)) {
      var fallbackTrackings = [-25, -50];
      for (var t = 0; t < fallbackTrackings.length; t++) {
        setLayerTracking(fallbackTrackings[t]);
        forceLayoutUpdate();
        var fbBounds = getRenderedTextBounds();
        if (!checkOverflow(fbBounds, containerWidth, containerHeight)) {
          break;
        }
      }
    }

    // Step 8: Re-apply final integer font size
    setLayerFontSize(bestFittingSize);
    forceLayoutUpdate();

    return "";
  }

  return {
    fitTextInSelection: fitTextInSelection,
    calculateSafeArea: calculateSafeArea,
    forceLayoutUpdate: forceLayoutUpdate,
    setLayerFontSize: setLayerFontSize,
    setLayerTracking: setLayerTracking,
    checkOverflow: checkOverflow
  };
})();
